{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i ./resources/css/locationpickr.css -o ./resources/dist/locationpickr.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i ./resources/css/locationpickr.css -o ./resources/dist/locationpickr.css --minify",
        "build:scripts": "node bin/build.js",
        "prettier": "npx prettier --write \"resources/{css,js,views}/**/*.{css,js,blade.php}\"",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm run prettier && npm-run-all build:*"
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.11.1",
        "@tailwindcss/cli": "^4.1.7",
        "esbuild": "^0.28.2",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.1.7"
    },
    "dependencies": {
        "@googlemaps/js-api-loader": "^1.16.2"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "core-js-pure@3.51.0": true,
        "fsevents@2.3.3": true,
        "esbuild@0.28.2": true
    }
}
